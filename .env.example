# Obligatoria: una contraseña de entre 4 y 1024 caracteres.
# No se exigen mayúsculas, números ni símbolos.
# No publiques este archivo con tus valores reales.
APP_PASSWORD=

# Puerto publicado en el host; la aplicación escucha en 8000 en el contenedor.
APP_PORT=8092

# Activa true si accedes exclusivamente por HTTPS mediante un proxy inverso.
# Para acceso HTTP local debe ser false.
COOKIE_SECURE=false
